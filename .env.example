NODE_ENV=development
NODE_PORT=3000
PYTHON_AI_URL=http://localhost:8001
PYTHON_AI_INTERNAL_KEY=

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_JWT=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

FRONTEND_URL=http://localhost:5173

MATCHING_SCORE_VERSION=matching-v4
TRUST_SCORE_VERSION=trust-v4
REALTIME_RULE_VERSION=realtime-v4
WEIGHT_PROFILE_VERSION=weights-v4-default

DEV_TESTER_ENABLED=true

