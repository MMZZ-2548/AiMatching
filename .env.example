EXCEPTIONAL_BASE_FIT_THRESHOLD=90
EXCEPTIONAL_MANDATORY_SKILLS_REQUIRED=true
EXCEPTIONAL_MAX_DISTANCE_KM=300
EXCEPTIONAL_REQUIRE_CAREGIVER_OPT_IN=true
EXCEPTIONAL_REQUIRE_FAMILY_OPT_IN=true

BUDGET_BELOW_MINIMUM_POLICY=FILTER
CHAT_UNLOCK_STAGE=MUTUAL_MATCH
